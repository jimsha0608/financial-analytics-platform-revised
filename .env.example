# Used by docker-compose.yml for full-stack local runs. Copy to .env and
# adjust before running `docker compose up --build`. This is separate from
# backend/.env.example, which is for running Django directly without Docker.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.prod

POSTGRES_DB=finance_db
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=finance_password

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Baked into the frontend build at image-build time (Vite env vars are
# resolved at build, not at container runtime).
VITE_API_BASE_URL=http://localhost:8000/api
